{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TitanBases/ai-workload-migration-manifest/main/schema/awmm.schema.json",
  "title": "AI Workload Migration Manifest (AWMM)",
  "description": "Draft v0.1.0 schema for an AI workload migration contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specVersion",
    "manifestId",
    "status",
    "workload",
    "source",
    "target",
    "assets"
  ],
  "properties": {
    "specVersion": {
      "const": "0.1.0"
    },
    "manifestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "status": {
      "enum": [
        "draft",
        "ready-for-review",
        "approved",
        "executing",
        "validated",
        "rolled-back",
        "failed",
        "archived"
      ]
    },
    "conformanceTarget": {
      "enum": [
        "core",
        "migration-ready",
        "evidence-complete"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "workload": {
      "$ref": "#/$defs/workload"
    },
    "source": {
      "$ref": "#/$defs/environment"
    },
    "target": {
      "$ref": "#/$defs/environment"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "transformations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transformation"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/risk"
      }
    },
    "baselines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/baseline"
      }
    },
    "acceptanceGates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gate"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "rollback": {
      "$ref": "#/$defs/rollback"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-fA-F0-9]{64}$"
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "criticality"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "description": {
          "type": "string",
          "maxLength": 4000
        },
        "kind": {
          "enum": [
            "agent",
            "multi-agent",
            "rag",
            "assistant",
            "model-serving",
            "workflow",
            "other"
          ]
        },
        "criticality": {
          "enum": [
            "low",
            "medium",
            "high",
            "mission-critical"
          ]
        },
        "owner": {
          "type": "string",
          "maxLength": 240
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environmentId"
      ],
      "properties": {
        "environmentId": {
          "$ref": "#/$defs/identifier"
        },
        "provider": {
          "type": "string",
          "maxLength": 160
        },
        "runtime": {
          "type": "string",
          "maxLength": 240
        },
        "runtimeVersion": {
          "type": "string",
          "maxLength": 120
        },
        "region": {
          "type": "string",
          "maxLength": 120
        },
        "model": {
          "type": "string",
          "maxLength": 240
        },
        "modelVersion": {
          "type": "string",
          "maxLength": 120
        },
        "endpointRef": {
          "$ref": "#/$defs/reference"
        },
        "notes": {
          "type": "string",
          "maxLength": 4000
        }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/reference"
        },
        "mediaType": {
          "type": "string",
          "maxLength": 160
        },
        "format": {
          "type": "string",
          "maxLength": 160
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "required",
        "portability"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "category": {
          "enum": [
            "instructions",
            "skills",
            "tools",
            "models",
            "memory",
            "retrieval-data",
            "embeddings",
            "state",
            "workflows",
            "identity",
            "permissions",
            "policies",
            "secrets",
            "observability",
            "evaluations",
            "other"
          ]
        },
        "name": {
          "type": "string",
          "maxLength": 240
        },
        "required": {
          "type": "boolean"
        },
        "portability": {
          "enum": [
            "portable",
            "transform-required",
            "rebind-required",
            "re-create-required",
            "unsupported",
            "unknown",
            "not-applicable"
          ]
        },
        "format": {
          "type": "string",
          "maxLength": 160
        },
        "protocol": {
          "type": "string",
          "maxLength": 160
        },
        "sourceRef": {
          "$ref": "#/$defs/reference"
        },
        "targetRef": {
          "$ref": "#/$defs/reference"
        },
        "artifact": {
          "$ref": "#/$defs/artifactRef"
        },
        "sensitivity": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        },
        "notes": {
          "type": "string",
          "maxLength": 4000
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "name",
        "required",
        "migrationTreatment"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "category": {
          "enum": [
            "runtime",
            "model",
            "api",
            "datastore",
            "vector-store",
            "tool",
            "protocol",
            "identity-provider",
            "secret-store",
            "observability",
            "queue",
            "network",
            "other"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "required": {
          "type": "boolean"
        },
        "version": {
          "type": "string",
          "maxLength": 120
        },
        "protocol": {
          "type": "string",
          "maxLength": 160
        },
        "sourceRef": {
          "$ref": "#/$defs/reference"
        },
        "targetRef": {
          "$ref": "#/$defs/reference"
        },
        "migrationTreatment": {
          "enum": [
            "retain",
            "replace",
            "rebind",
            "transform",
            "remove",
            "re-create",
            "unresolved"
          ]
        },
        "notes": {
          "type": "string",
          "maxLength": 4000
        }
      }
    },
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "assetRefs",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "enum": [
            "format-conversion",
            "semantic-remap",
            "policy-remap",
            "re-embedding",
            "prompt-adaptation",
            "tool-contract-adaptation",
            "identity-rebinding",
            "secret-rebinding",
            "state-rehydration",
            "workflow-rewrite",
            "model-substitution",
            "other"
          ]
        },
        "assetRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "reversible": {
          "type": "boolean"
        },
        "implementationRef": {
          "$ref": "#/$defs/reference"
        },
        "evidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "severity",
        "likelihood",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "category": {
          "enum": [
            "behavioral-drift",
            "data-loss",
            "memory-loss",
            "state-loss",
            "semantic-drift",
            "permission-drift",
            "safety-regression",
            "security-regression",
            "latency-regression",
            "cost-regression",
            "tool-contract-breakage",
            "compliance",
            "observability-gap",
            "rollback-failure",
            "other"
          ]
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "likelihood": {
          "enum": [
            "rare",
            "unlikely",
            "possible",
            "likely",
            "almost-certain",
            "unknown"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "mitigations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "acceptanceGateRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "domain",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "domain": {
          "enum": [
            "functional",
            "behavioral",
            "quality",
            "safety",
            "security",
            "latency",
            "reliability",
            "cost",
            "memory",
            "retrieval",
            "tool-contract",
            "other"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "metric": {
          "type": "string",
          "maxLength": 240
        },
        "value": {
          "type": [
            "number",
            "integer",
            "string",
            "boolean"
          ]
        },
        "unit": {
          "type": "string",
          "maxLength": 120
        },
        "datasetRef": {
          "$ref": "#/$defs/reference"
        },
        "measurementRef": {
          "$ref": "#/$defs/reference"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "gateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "not-run",
            "waived"
          ]
        },
        "observed": {
          "type": [
            "number",
            "integer",
            "string",
            "boolean"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "notes": {
          "type": "string",
          "maxLength": 4000
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "domain",
        "criterion",
        "blocking",
        "evidenceRequired"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "domain": {
          "enum": [
            "functional",
            "behavioral",
            "tool-contract",
            "memory-integrity",
            "state-continuity",
            "identity-permissions",
            "safety",
            "security",
            "observability",
            "latency",
            "reliability",
            "cost",
            "compliance",
            "rollback",
            "other"
          ]
        },
        "criterion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "blocking": {
          "type": "boolean"
        },
        "evidenceRequired": {
          "type": "boolean"
        },
        "operator": {
          "enum": [
            "eq",
            "ne",
            "gt",
            "gte",
            "lt",
            "lte",
            "contains",
            "human-review"
          ]
        },
        "threshold": {
          "type": [
            "number",
            "integer",
            "string",
            "boolean"
          ]
        },
        "unit": {
          "type": "string",
          "maxLength": 120
        },
        "baselineRef": {
          "$ref": "#/$defs/identifier"
        },
        "result": {
          "$ref": "#/$defs/gateResult"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "ref"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "enum": [
            "test-report",
            "benchmark",
            "hash",
            "trace",
            "log",
            "attestation",
            "approval",
            "diff",
            "provenance",
            "other"
          ]
        },
        "ref": {
          "$ref": "#/$defs/reference"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "producer": {
          "type": "string",
          "maxLength": 240
        },
        "gateRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "notes": {
          "type": "string",
          "maxLength": 4000
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "strategy"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "strategy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "triggerConditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "sourceSnapshotRef": {
          "$ref": "#/$defs/reference"
        },
        "maxRtoMinutes": {
          "type": "integer",
          "minimum": 0
        },
        "validated": {
          "type": "boolean"
        },
        "evidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owner": {
          "type": "string",
          "maxLength": 240
        },
        "generatedBy": {
          "type": "string",
          "maxLength": 240
        },
        "approvedBy": {
          "type": "string",
          "maxLength": 240
        },
        "sourceRevision": {
          "type": "string",
          "maxLength": 240
        },
        "toolVersions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 120
          }
        }
      }
    }
  }
}
